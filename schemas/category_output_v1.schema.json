{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "prompt_version", "annotations"],
  "properties": {
    "schema": {"const": "fragment_category_annotations_batch_v1"},
    "prompt_version": {"const": "category_v1"},
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fragment_id", "primary_category", "secondary_category", "mixed_category", "confidence", "short_reason"],
        "properties": {
          "fragment_id": {"type": "string"},
          "primary_category": {"enum": ["Background", "Motivation", "Goal", "Method", "Experiment", "Result", "Conclusion", "Hypothesis"]},
          "secondary_category": {"type": ["string", "null"], "enum": ["Background", "Motivation", "Goal", "Method", "Experiment", "Result", "Conclusion", "Hypothesis", null]},
          "mixed_category": {"type": "boolean"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "short_reason": {"type": "string"}
        }
      }
    }
  }
}

