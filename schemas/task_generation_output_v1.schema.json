{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "fragments"],
  "properties": {
    "schema": {"const": "task_reverse_generation_batch_v1"},
    "fragments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fragment_id", "task_candidates", "failure_reasons"],
        "properties": {
          "fragment_id": {"type": "string"},
          "task_candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["candidate_index", "task_variant_mode", "task_spec", "answer_core_to_withhold", "task_prompt", "generation_checks", "generation_confidence", "short_note"],
              "properties": {
                "candidate_index": {"type": "integer", "minimum": 1, "maximum": 3},
                "task_variant_mode": {"type": "string"},
                "task_spec": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["structure_type", "fields", "requested_operation"],
                  "properties": {
                    "structure_type": {"type": "string"},
                    "fields": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["name", "items"],
                        "properties": {
                          "name": {"type": "string"},
                          "items": {"type": "array", "items": {"type": "string"}}
                        }
                      }
                    },
                    "requested_operation": {"type": "string"}
                  }
                },
                "answer_core_to_withhold": {"type": "array", "items": {"type": "string"}},
                "task_prompt": {"type": "string"},
                "generation_checks": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["self_contained", "source_agnostic", "literal_leakage", "paraphrase_leakage", "causal_leakage", "distinct_from_other_candidates"],
                  "properties": {
                    "self_contained": {"type": "boolean"},
                    "source_agnostic": {"type": "boolean"},
                    "literal_leakage": {"type": "boolean"},
                    "paraphrase_leakage": {"type": "boolean"},
                    "causal_leakage": {"type": "boolean"},
                    "distinct_from_other_candidates": {"type": "boolean"}
                  }
                },
                "generation_confidence": {"type": "number", "minimum": 0, "maximum": 1},
                "short_note": {"type": "string"}
              }
            }
          },
          "failure_reasons": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}

